{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cmake-pedantic",
      "hidden": true,
      "warnings": {
        "dev": true,
        "deprecated": true,
        "uninitialized": true,
        "unusedCli": true,
        "systemVars": false
      },
      "errors": {
        "dev": true,
        "deprecated": true
      }
    },
    {
      "name": "dev-mode",
      "hidden": true,
      "inherits": "cmake-pedantic",
      "cacheVariables": {
        "speedgun-ng_DEVELOPER_MODE": "ON"
      }
    },
    {
      "name": "cppcheck",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_CPPCHECK": "cppcheck;--inline-suppr"
      }
    },
    {
      "name": "clang-tidy",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy;--header-filter=^${sourceDir}/;--exclude-header-filter=^${sourceDir}/external/"
      }
    },
    {
      "name": "ci-std",
      "description": "This preset makes sure the project actually builds with at least the specified standard",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON"
      }
    },
    {
      "name": "flags-gcc-clang",
      "description": "These flags are supported by both GCC and Clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-D_GLIBCXX_ASSERTIONS=1 -fstack-protector-strong -fcf-protection=full -fstack-clash-protection -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wcast-qual -Wformat=2 -Wundef -Werror=float-equal -Wshadow -Wcast-align -Wunused -Wnull-dereference -Wdouble-promotion -Wimplicit-fallthrough -Wextra-semi -Woverloaded-virtual -Wnon-virtual-dtor -Wold-style-cast -Werror",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--allow-shlib-undefined,--as-needed,-z,noexecstack,-z,relro,-z,now,-z,nodlopen",
        "CMAKE_SHARED_LINKER_FLAGS": "-Wl,--allow-shlib-undefined,--as-needed,-z,noexecstack,-z,relro,-z,now,-z,nodlopen"
      }
    },
    {
      "name": "ci-linux",
      "description": "Includes fortification with the CMake default release flags",
      "inherits": ["flags-gcc-clang", "ci-std"],
      "generator": "Unix Makefiles",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3 -O3 -DNDEBUG"
      }
    },
    {
      "name": "ci-linux-ignore",
      "description": "ci-linux flags at the ignore contract semantic, for a job that audits a release archive. Developer mode stays off the preset because each tree passes its own value.",
      "binaryDir": "${sourceDir}/build/ci-linux-ignore",
      "inherits": "ci-linux",
      "cacheVariables": {
        "speedgun-ng_CONTRACTS": "ignore"
      }
    },
    {
      "name": "ci-linux-audit",
      "description": "ci-linux flags for the two jobs that install a release tree to audit its package surface. The preset adds no cache variable: both trees already run at the enforcing contract semantic and with developer mode off, which are the defaults (T186).",
      "binaryDir": "${sourceDir}/build/ci-linux-audit",
      "inherits": "ci-linux"
    },
    {
      "name": "coverage-linux",
      "description": "A forked test child flushes its counters through __gcov_dump before it exits. libgcov defines that symbol in an archive member nothing else references, and a weak reference never pulls an archive member, so a plain --coverage link leaves it null and the child's counts vanish while its test still passes. Forcing the symbol undefined pulls the member.",
      "binaryDir": "${sourceDir}/build/coverage",
      "inherits": "ci-linux",
      "hidden": true,
      "cacheVariables": {
        "ENABLE_COVERAGE": "ON",
        "CMAKE_BUILD_TYPE": "Coverage",
        "CMAKE_CXX_FLAGS_COVERAGE": "-Og -g --coverage -fprofile-update=atomic -fno-inline -fkeep-inline-functions -fkeep-static-functions",
        "CMAKE_EXE_LINKER_FLAGS_COVERAGE": "--coverage -fprofile-update=atomic -Wl,-u,__gcov_dump",
        "CMAKE_SHARED_LINKER_FLAGS_COVERAGE": "--coverage -fprofile-update=atomic -Wl,-u,__gcov_dump"
      }
    },
    {
      "name": "ci-coverage",
      "description": "The capture builds without -D_GLIBCXX_ASSERTIONS, because that flag adds standard-library branches inside the inline atomic operations that no project test can reach.",
      "inherits": ["coverage-linux", "dev-mode"],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fstack-protector-strong -fcf-protection=full -fstack-clash-protection -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wcast-qual -Wformat=2 -Wundef -Werror=float-equal -Wshadow -Wcast-align -Wunused -Wnull-dereference -Wdouble-promotion -Wimplicit-fallthrough -Wextra-semi -Woverloaded-virtual -Wnon-virtual-dtor -Wold-style-cast -Werror"
      }
    },
    {
      "name": "ci-sanitize",
      "binaryDir": "${sourceDir}/build/sanitize",
      "inherits": ["ci-linux", "dev-mode"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Sanitize",
        "CMAKE_CXX_FLAGS_SANITIZE": "-U_FORTIFY_SOURCE -O2 -g -fsanitize=address,undefined -fno-omit-frame-pointer -fno-common"
      }
    },
    {
      "name": "ci-tsan",
      "description": "ci-linux flags at the thread sanitizer, on the project and on every vendored tree. The flags ride the Release config, which a cache variable passes to each add_subdirectory, so the vendored sources are instrumented too. ci-sanitize keeps address and undefined behavior alone, because the compilers reject the pairing.",
      "binaryDir": "${sourceDir}/build/tsan",
      "inherits": ["ci-linux", "dev-mode"],
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELEASE": "-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3 -O2 -g -DNDEBUG -fsanitize=thread -fno-omit-frame-pointer -fno-common",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "-fsanitize=thread"
      }
    },
    {
      "name": "ci-build",
      "binaryDir": "${sourceDir}/build",
      "hidden": true
    },
    {
      "name": "ci-cache",
      "description": "ccache fronts every compile of a build that inherits this preset. It is abstract like dev-mode: no generator and no binaryDir, so it is inherited and never configured directly.",
      "hidden": true,
      "inherits": "dev-mode",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "ci-ubuntu",
      "inherits": ["ci-build", "ci-linux", "clang-tidy", "cppcheck", "dev-mode"]
    },
    {
      "name": "ci-ubuntu-test",
      "inherits": ["ci-build", "ci-linux", "dev-mode", "ci-cache"],
      "cacheVariables": {
        "SPEEDGUN_DBC_MATRIX": "ON"
      }
    },
    {
      "name": "ci-rocky",
      "inherits": ["ci-build", "ci-linux", "dev-mode"]
    },
    {
      "name": "prepush",
      "description": "The local pre-push build tree, kept out of the CI tree at build. The generator is named here because none of the presets this one inherits names a generator.",
      "binaryDir": "${sourceDir}/build/prepush",
      "generator": "Unix Makefiles",
      "inherits": ["ci-build", "dev-mode", "ci-cache"]
    }
  ],
  "buildPresets": [
    {
      "name": "ci-sanitize",
      "configurePreset": "ci-sanitize"
    },
    {
      "name": "ci-tsan",
      "configurePreset": "ci-tsan"
    }
  ],
  "testPresets": [
    {
      "name": "ci-tsan",
      "configurePreset": "ci-tsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-sanitize",
      "configurePreset": "ci-sanitize",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "prepush-quick",
      "configurePreset": "prepush",
      "filter": {
        "labelInclude": "quick"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "prepush-full",
      "configurePreset": "prepush",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
