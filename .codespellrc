[codespell]
builtin = clear,rare,en-GB_to_en-US,names,informal,code
check-filenames =
check-hidden =
# node_modules appears in .opencode/ when AI coding agents install plugin
# dependencies there; never spell-check vendored JS. .omo is OhMyOpenCode
# agent scratch state (session transcripts), not project content.
# build-shared is the shared-build hwloc prefix the local lanes leave
# beside build-tidy; neither exists on a CI runner. A lane working beside
# one configures a tree of its own name (build-val, build-hdr, build-wtr),
# so the whole build-* family stands skipped: the generated headers under
# such a tree carry words no project text owns, and a gate that reports
# them teaches people to ignore the gate.
skip = */.git,*/build,*/build-*,*/build-tidy,*/build-shared,*/prefix,*/node_modules,*/.omo,*/external
# False positives from Spec Kit's vendored shell scripts
# (.specify/scripts/bash/common.sh): "unparseable" is valid English and
# "strat" is a shell variable (short for strategy).
# "Sur" is the macOS Big Sur codename in specs/003-vendor-hwloc docs.
# "analogue" is British spelling in specs/003-vendor-hwloc/plan.md:42.
# The 007 counters and timers words below are the same class of finding.
# "copyable" and "deque" are codespell false positives no text change
# removes: "copiable" is not a word and "dequeue" would break
# std::deque. "stdio" is the same class: it is the C standard I/O
# library's own name, spelled with the o, and the only alternative
# codespell proposes ("studio") is a different word entirely
# (tools/quill/quill_dependency_check.cpp).
# "behaviour", "judgement", "licence", "serialisation", and
# "organisation" are correct British spellings, part of them in closed
# artifacts (specs/007-counters-and-timers) and in the project's own prose.
# "onOther" is a renamed identifier (specs/014-identifier-naming-camelcase,
# test/source/counters_linux_pmu_seam_test.cpp); codespell's typo
# dictionary proposes "another", a different word.
# "nowNs" is the same class: a renamed identifier
# (specs/014-identifier-naming-camelcase, tools/dbc/overhead.cpp) whose
# unit suffix makes codespell propose "knowns" or "nouns".
# "Compilability" is a data-model property name (specs/018-docs-main-page/
# data-model.md): the rule that a page block compiles as pasted under the
# canonical includes. Codespell's code dictionary proposes "Compatibility",
# a different word, and no text change keeps the property name.
# "unexpect" is the std::unexpect in-place error tag (source/harness/runner.cpp):
# the standard's own name for it, and codespell's dictionary proposes
# "unexpected", a different token that would not compile.
# "stoll" is the std::stoll string-to-integer conversion
# (test/source/harness_graph_report_test.cpp): the standard library's own
# name for it, and codespell's typo dictionary proposes "still", a
# different word that would not compile.
# "cancelled" is the conclusion string GitHub Actions returns for a run its
# concurrency group stopped (.github/workflows/ci.yml concurrency block);
# records that quote the API value cannot drop the double l, and prose keeps
# the American spelling the rest of this file uses (specs/030-ci-speedup).
ignore-words-list = unparseable,strat,sur,analogue,copyable,deque,stdio,behaviour,judgement,licence,serialisation,organisation,onother,nowns,compilability,unexpect,cancelled,stoll
quiet-level = 2
