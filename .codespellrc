[codespell]
builtin = clear,rare,en-GB_to_en-US,names,informal,code
check-filenames =
check-hidden =
# node_modules appears in .opencode/ when AI coding agents install plugin
# dependencies there; never spell-check vendored JS. .omo is OhMyOpenCode
# agent scratch state (session transcripts), not project content.
skip = */.git,*/build,*/prefix,*/node_modules,*/.omo,*/external
# False positives from Spec Kit's vendored shell scripts
# (.specify/scripts/bash/common.sh): "unparseable" is valid English and
# "strat" is a shell variable (short for strategy).
# "Sur" is the macOS Big Sur codename in specs/003-vendor-hwloc docs.
# "analogue" is British spelling in specs/003-vendor-hwloc/plan.md:42.
# The 007 counters and timers words below are the same class of finding.
# "copyable" and "deque" are codespell false positives no text change
# removes: "copiable" is not a word and "dequeue" would break
# std::deque. "stdio" is the same class: it is the C standard I/O
# library's own name, spelled with the o, and the only alternative
# codespell proposes ("studio") is a different word entirely
# (tools/quill/quill_dependency_check.cpp).
# "behaviour", "judgement", "licence", "serialisation", and
# "organisation" are correct British spellings, part of them in closed
# artifacts (specs/007-counters-and-timers) and in the project's own prose.
ignore-words-list = unparseable,strat,sur,analogue,copyable,deque,stdio,behaviour,judgement,licence,serialisation,organisation
quiet-level = 2
