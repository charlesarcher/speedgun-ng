      "properties": {
        "serial": { "type": "boolean" },
        "windowMs": { "type": "integer" },
        "cpus": {
          "type": "array",
          "items": {
            "type": "object",
            "x-order": ["cpu", "role", "stats", "attribution"],
            "required": ["cpu", "role", "stats", "attribution"],
            "additionalProperties": false,
            "properties": {
              "cpu": { "type": "integer" },
              "role": { "type": "string", "enum": ["planned", "candidate"] },
              "stats": {
                "type": "object",
                "x-order": [
                  "gapCount",
                  "gapsPerSecond",
                  "minNs",
                  "medianNs",
                  "meanNs",
                  "p90Ns",
                  "p99Ns",
                  "p999Ns",
                  "p9999Ns",
                  "maxNs",
                  "totalNs",
                  "totalPercent",
                  "runtimeNs",
                  "thresholdNs",
                  "loopPeriodNs",
                  "droppedGaps"
                ],
                "required": [
                  "gapCount",
                  "gapsPerSecond",
                  "minNs",
                  "medianNs",
                  "meanNs",
                  "p90Ns",
                  "p99Ns",
                  "p999Ns",
                  "p9999Ns",
                  "maxNs",
                  "totalNs",
                  "totalPercent",
                  "runtimeNs",
                  "thresholdNs",
                  "loopPeriodNs",
                  "droppedGaps"
                ],
                "additionalProperties": false,
                "properties": {
                  "gapCount": { "type": "integer" },
                  "gapsPerSecond": { "type": "number" },
                  "minNs": { "type": "integer" },
                  "medianNs": { "type": "integer" },
                  "meanNs": { "type": "number" },
                  "p90Ns": { "type": "integer" },
                  "p99Ns": { "type": "integer" },
                  "p999Ns": { "type": "integer" },
                  "p9999Ns": { "type": "integer" },
                  "maxNs": { "type": "integer" },
                  "totalNs": { "type": "integer" },
                  "totalPercent": { "type": "number" },
                  "runtimeNs": { "type": "integer" },
                  "thresholdNs": { "type": "integer" },
                  "loopPeriodNs": { "type": "integer" },
                  "droppedGaps": { "type": "integer" }
                }
              },
              "attribution": {
                "type": "object",
                "x-order": ["interrupts", "softirqs", "switchDelta", "scheduleDelta"],
                "required": ["interrupts", "softirqs", "switchDelta", "scheduleDelta"],
