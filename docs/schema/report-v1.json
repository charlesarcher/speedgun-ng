          "suite",
          "case",
          "outcome",
          "hideRepetitionRows",
          "timeUnit",
          "primaryIsCpu",
          "pauseSamplesFolded",
          "percentilePoints",
          "contexts",
          "rows",
          "metricLabels",
          "counterLabels",
          "counterStats",
          "statisticValues",
          "metricMethod",
