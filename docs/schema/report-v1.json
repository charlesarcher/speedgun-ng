{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speedgun-ng.dev/schema/report-v1.json",
  "title": "speedgun-ng benchmark report",
  "description": "The document the harness writes for one batch (specs/023 FR-008). Key order is normative and stands in x-order; the harness checker reads this file and compares the key set, the key order and the value kinds of every written document against it.",
  "type": "object",
  "x-order": ["schemaVersion", "speedgun", "run", "jitter", "precheck", "benchmarks", "hunt"],
  "required": ["schemaVersion", "speedgun", "benchmarks"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "speedgun": {
      "type": "object",
      "x-order": ["version", "buildType"],
      "required": ["version", "buildType"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "buildType": { "type": "string" }
      }
    },
    "run": {
      "type": "object",
      "x-order": ["interleave", "options"],
      "additionalProperties": true,
      "properties": {
        "interleave": { "type": "integer", "minimum": 0 },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "x-order": ["option", "source", "value"],
            "additionalProperties": true,
            "properties": {
              "option": { "type": "string" },
              "source": { "type": "string", "enum": ["file", "environment"] },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "jitter": {
      "type": "object",
      "x-order": [
        "mode",
        "thresholdNs",
        "loopPeriodNs",
        "cpus",
        "stats",
        "droppedGaps",
        "disclosure"
      ],
      "required": [
        "mode",
        "thresholdNs",
        "loopPeriodNs",
        "cpus",
        "stats",
        "droppedGaps",
        "disclosure"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["ALONGSIDE", "PRECHECK", "BOTH"]
        },
        "thresholdNs": { "type": "integer" },
        "loopPeriodNs": { "type": "integer" },
        "cpus": { "type": "array", "items": { "type": "integer" } },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "x-order": [
              "cpu",
              "gapCount",
              "gapsPerSecond",
              "minNs",
              "medianNs",
              "meanNs",
              "p90Ns",
              "p99Ns",
              "p999Ns",
              "p9999Ns",
              "maxNs",
              "totalNs",
              "totalPercent",
              "runtimeNs",
              "thresholdNs",
              "loopPeriodNs",
              "droppedGaps",
              "gaps"
            ],
            "required": [
              "cpu",
              "gapCount",
              "gapsPerSecond",
              "minNs",
              "medianNs",
              "meanNs",
              "p90Ns",
              "p99Ns",
              "p999Ns",
              "p9999Ns",
              "maxNs",
              "totalNs",
              "totalPercent",
              "runtimeNs",
              "thresholdNs",
              "loopPeriodNs",
              "droppedGaps"
            ],
            "additionalProperties": false,
            "properties": {
              "cpu": { "type": "integer" },
              "gapCount": { "type": "integer" },
              "gapsPerSecond": { "type": "number" },
              "minNs": { "type": "integer" },
              "medianNs": { "type": "integer" },
              "meanNs": { "type": "number" },
              "p90Ns": { "type": "integer" },
              "p99Ns": { "type": "integer" },
              "p999Ns": { "type": "integer" },
              "p9999Ns": { "type": "integer" },
              "maxNs": { "type": "integer" },
              "totalNs": { "type": "integer" },
              "totalPercent": { "type": "number" },
              "runtimeNs": { "type": "integer" },
              "thresholdNs": { "type": "integer" },
              "loopPeriodNs": { "type": "integer" },
              "droppedGaps": { "type": "integer" },
              "gaps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "x-order": ["stamp", "gapNs"],
                  "required": ["stamp", "gapNs"],
                  "additionalProperties": false,
                  "properties": {
                    "stamp": { "type": "integer" },
                    "gapNs": { "type": "integer" }
                  }
                }
              }
            }
          }
        },
        "droppedGaps": { "type": "integer" },
        "disclosure": { "type": "string" }
      }
    },
    "precheck": {
      "type": "object",
      "x-order": ["serial", "windowMs", "cpus", "hostSettings", "skippedGroups"],
      "required": ["serial", "windowMs", "cpus", "hostSettings", "skippedGroups"],
