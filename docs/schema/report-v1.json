          "suite",
          "case",
          "outcome",
          "reason",
          "hideRepetitionRows",
          "timeUnit",
          "primaryIsCpu",
          "pauseSamplesFolded",
          "percentilePoints",
          "contexts",
          "noiseWarning",
          "jitter",
          "rows",
          "metricLabels",
          "counterLabels",
          "counterStats",
          "statisticValues",
          "metricMethod",
          "passCount",
          "passSpread",
          "spreadWarning",
