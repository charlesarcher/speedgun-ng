                    "properties": {
                      "label": { "type": "string" },
                      "value": { "type": "number" },
                      "runningRatio": { "type": "number" },
                      "scaled": { "type": "boolean" },
                      "availability": {
                        "type": "string",
                        "enum": [
                          "COUNTABLE",
                          "PERMISSION_BLOCKED",
                          "NOT_ENCODABLE",
                          "ABSENT",
                          "SCOPE_REFUSED",
                          "GAP"
                        ]
                      },
                      "pass": { "type": ["integer", "null"] }
                    }
                  }
                },
                "counters": {
                  "type": "array",
                  "items": { "type": "number" }
