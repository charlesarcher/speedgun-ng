**/.DS_Store
.idea/
.vs/
.vscode/
build/
cmake-build-*/
# Scratch build trees the installed-package consumer test configures
build-consumer*/
build-tidy/
# Lane-owned build trees for verification runs (coverage, sanitizers, tidy)
build-*/
prefix/
.clangd
CMakeLists.txt.user
CMakeUserPresets.json
compile_commands.json
env.bat
env.ps1
# Python bytecode from the DBC helper scripts under tools/
__pycache__/
# Agent scratch state (machine-local, never committed)
.omo/
q.md
speedgun-ng-*-specify-prompt.md
# Spec Kit: share the commands, ignore any other agent state
.opencode/*
!.opencode/commands/
.agents/*
!.agents/skills/

# In-source compiler products
*.o
*.a
*.so
*.log

# Report captures written by harness suites run from the repository root:
# the fixed names, and the names harness_cli_test suffixes with its pid.
harness_*_out.txt
/harness_cli_*
