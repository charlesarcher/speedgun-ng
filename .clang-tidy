---
# Enable ALL the things! Except not really
# misc-non-private-member-variables-in-classes: the options don't do anything
# modernize-use-nodiscard: too aggressive, attribute is situationally useful
# llvm-prefer-static-over-anonymous-namespace: fights misc-use-anonymous-namespace,
#   which the wildcard enables alongside it. A file-local function cannot satisfy
#   both. This tree uses anonymous namespaces throughout, so that check is the one
#   that disagrees with the convention here (269 findings against 1 the other way).
Checks: "*,\
  -google-readability-todo,\
  -altera-*,\
  -fuchsia-*,\
  fuchsia-multiple-inheritance,\
  -llvm-header-guard,\
  -llvm-include-order,\
  -llvmlibc-*,\
  -modernize-use-nodiscard,\
  -misc-non-private-member-variables-in-classes,\
  -llvm-prefer-static-over-anonymous-namespace"
HeaderFilterRegex: '/include/speedgun-ng/.*|/source/.*'
WarningsAsErrors: 'readability-identifier-naming'
CheckOptions:
  # N-1: every type the project owns takes PascalCase. One acronym spells
  # as one word, so PmuTableEntry, not PMUTableEntry.
  - key: 'readability-identifier-naming.ClassCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.StructCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.UnionCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.EnumCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.TypeAliasCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.TypedefCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.AbstractClassCase'
    value: 'CamelCase'
  # N-2: every function takes camelBack, member or not.
  - key: 'readability-identifier-naming.FunctionCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.MethodCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.ClassMethodCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.ConstexprFunctionCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.ConstexprMethodCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.PrivateMethodCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.ProtectedMethodCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.PublicMethodCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.VirtualMethodCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.GlobalFunctionCase'
    value: 'camelBack'
  # N-3: a macro takes UPPER_SNAKE_CASE under SG_. The export header
  # generator and every include guard write their own name and carry no
  # prefix, which is the exception entry both cite.
  - key: 'readability-identifier-naming.MacroDefinitionCase'
    value: 'UPPER_CASE'
  - key: 'readability-identifier-naming.MacroDefinitionPrefix'
    value: 'SG_'
  - key: 'readability-identifier-naming.MacroDefinitionIgnoredRegexp'
    value: '^SPEEDGUN_NG_'
  # N-4: a scoped enumerator takes UPPER_SNAKE_CASE, no prefix.
  - key: 'readability-identifier-naming.EnumConstantCase'
    value: 'UPPER_CASE'
  - key: 'readability-identifier-naming.ScopedEnumConstantCase'
    value: 'UPPER_CASE'
  # N-5: a variable takes camelBack.
  - key: 'readability-identifier-naming.VariableCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.ParameterCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.LocalVariableCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.LocalConstantCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.PublicMemberCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.PrivateMemberCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.PrivateMemberPrefix'
    value: 'm_'
  - key: 'readability-identifier-naming.ProtectedMemberCase'
    value: 'camelBack'
  - key: 'readability-identifier-naming.ProtectedMemberPrefix'
    value: 'm_'
  # N-6: a namespace takes lower_case.
  - key: 'readability-identifier-naming.NamespaceCase'
    value: 'lower_case'
  - key: 'readability-identifier-naming.InlineNamespaceCase'
    value: 'lower_case'
  # N-7: a template parameter takes PascalCase.
  - key: 'readability-identifier-naming.TemplateParameterCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.TypeTemplateParameterCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.ValueTemplateParameterCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.TemplateTemplateParameterCase'
    value: 'CamelCase'
  # The constant spelling: a named constant takes PascalCase under k. A
  # tag object is the exception N-11 names, and the kernel page fields are
  # the exception the specification lists.
  - key: 'readability-identifier-naming.ConstexprVariableCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.ConstexprVariablePrefix'
    value: 'k'
  - key: 'readability-identifier-naming.StaticConstantCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.StaticConstantPrefix'
    value: 'k'
  - key: 'readability-identifier-naming.GlobalConstantCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.GlobalConstantPrefix'
    value: 'k'
  - key: 'readability-identifier-naming.ClassConstantCase'
    value: 'CamelCase'
  - key: 'readability-identifier-naming.ClassConstantPrefix'
    value: 'k'
  # N-11: a tag object keeps lowerCamelCase beside its PascalCase tag type.
  - key: 'readability-identifier-naming.ConstexprVariableIgnoredRegexp'
    value: '(hardStop|ring|cyc|offset)'
  # The exception list: the fields of perf_event_mmap_page and
  # perf_event_attr are kernel names, so a struct that mirrors the mapped
  # page keeps their spelling.
  - key: 'readability-identifier-naming.PublicMemberIgnoredRegexp'
    value: '(cap_user_rdpmc|cap_user_time|cap_user_time_short|cap_usr_time_short|pmc_width|time_enabled|time_running|time_shift|time_mult|time_offset|time_cycles|time_mask)'
  - key: 'readability-identifier-naming.LocalConstantIgnoredRegexp'
    value: '(cap_user_rdpmc|cap_user_time|cap_user_time_short|cap_usr_time_short|pmc_width|time_enabled|time_running|time_shift|time_mult|time_offset|time_cycles|time_mask)'
  - key: 'readability-identifier-naming.ParameterIgnoredRegexp'
    value: '(cap_user_rdpmc|cap_user_time|cap_user_time_short|cap_usr_time_short|pmc_width|time_enabled|time_running|time_shift|time_mult|time_offset|time_cycles|time_mask)'
  # main in each executable, and every identifier inside external/.
  - key: 'readability-identifier-naming.IgnoreMainLikeFunctions'
    value: 'true'
  # The container and range protocol names the exception list keeps.
  # Each is one lower-case word and passes camelBack today; the entry
  # states the exception so a future spelling near them is reviewed
  # against the list and not against a finding.
  - key: 'readability-identifier-naming.FunctionIgnoredRegexp'
    value: '^(begin|end|cbegin|cend|rbegin|rend|size|empty|data|swap|get)$'
  - key: 'readability-identifier-naming.MethodIgnoredRegexp'
    value: '^(begin|end|cbegin|cend|rbegin|rend|size|empty|data|swap|get)$'
  # The standard member types the exception list keeps.
  - key: 'readability-identifier-naming.TypeAliasIgnoredRegexp'
    value: '^(value_type|size_type|difference_type|reference|const_reference|pointer|iterator|const_iterator|iterator_category|iterator_concept|element_type)$'
...
